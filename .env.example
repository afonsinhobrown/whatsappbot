# --- Servidor ---
# Porta onde o bot vai correr em local
PORT=3000

# --- Meta Cloud API ---
# 1) VERIFY_TOKEN: inverte um texto qualquer e fácil de lembrar.
#    Ele serve para a Meta confirmar que o webhook é teu.
#    Ex.: VERIFY_TOKEN=tecno2024
VERIFY_TOKEN=troque_esta_string

# 2) PHONE_NUMBER_ID: Meta for Developers > WhatsApp > API Setup > Phone number ID
PHONE_NUMBER_ID=

# 3) WHATSAPP_TOKEN: Meta for Developers > WhatsApp > API Setup > Temporary access token
#    (em produção, gera um Permanent Token no Meta Business Manager)
WHATSAPP_TOKEN=

# 4) APP_SECRET: Meta for Developers > App > App settings > Basic > App secret.
#    É usado para validar a assinatura (X-Hub-Signature-256) dos webhooks da Meta.
APP_SECRET=

# --- Base de dados (Neon / Postgres) ---
# Deixe vazio para usar a base de dados DEMO em memória (testes locais).
# Depois coloque a ligação do Neon (formato: postgresql://user:pass@host/db?sslmode=require)
DATABASE_URL=

# --- Painel Admin ---
# Password de acesso ao painel em /admin
ADMIN_PASSWORD=
